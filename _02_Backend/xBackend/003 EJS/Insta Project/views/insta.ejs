<body>
   <h1><%= username %></h1>
   <p>Followers: <%= user.followers %></p>
   <p>Following: <%= user.following %></p>
   <h2>Posts</h2>
   <% user.posts.forEach(post => { %>
      <div>
         <img src="<%= post.image %>" alt="Post Image">
         <p>Likes: <%= post.likes %></p>
         <p>Comments: <%= post.comments %></p>
      </div>
   <% }); %>
</body>
</html>