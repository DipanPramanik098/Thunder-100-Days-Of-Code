<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RollDice</title>
</head>
<body>
    <h1>Roll the Dice!</h1>
    <p>Your roll: <%= randomNumber %></p>
    <% if(randomNumber == 6) { %>
        <p>Congratulations! You rolled a six!</p>
    <% } else if(randomNumber == 1) { %>
        <p>Oh no! You rolled a one!</p>
    <% }else { %>
        <p>Not a special roll.</p>
    <% } %>

</body>
</html>